# 复制为 .env 或在 docker compose / orkestr 环境变量里填写
ADDR=:8000
SITE_URL=https://your-domain.example

# ---- 数据库（二选一）----
# 生产：MySQL（compose 里服务名 mysql）
DATABASE_URL=mysql://wk:wkpass@mysql:3306/wk_dl
# 演示：无 MySQL 时打开（数据仅容器内，重启可能丢）
# ALLOW_SQLITE=1

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
REGISTER_OPEN=0
REGISTER_CODE=

